{
  "name": "@pavelungr/seznam-webmaster-mcp",
  "version": "0.1.4",
  "description": "MCP server for Seznam Webmaster API — manage indexation status, documents, history, and reindex requests across multiple sites from a single place.",
  "license": "MIT",
  "author": "Pavel Ungr <jsem@pavelungr.cz>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavelungr/seznam-webmaster-mcp.git"
  },
  "homepage": "https://github.com/pavelungr/seznam-webmaster-mcp",
  "bugs": {
    "url": "https://github.com/pavelungr/seznam-webmaster-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "seznam",
    "webmaster",
    "seo",
    "indexation",
    "claude",
    "llm"
  ],
  "type": "module",
  "bin": {
    "seznam-webmaster-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "README.cs.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "smoke": "npm run build && node tests/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "typescript": "^5.4.5"
  }
}
